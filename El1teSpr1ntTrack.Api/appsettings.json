{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=El1teAPIDb; Trusted_Connection=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Key": "super_secret_key_1234567890", // actual key in secrets
    "Issuer": "El1teSpr1ntAPI",
    "Audience": "El1teSpr1ntFrontend"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  },
  "AllowedHosts": "*"
}
